{
  "name": "Default Theme",
  "version": "1.0.0",
  "author": "Kiddo's Heaven",
  "description": "Clean, modern theme for kids products",
  "colors": {
    "primary": "#3b82f6",
    "secondary": "#8b5cf6",
    "accent": "#f59e0b",
    "neutral": "#6b7280",
    "success": "#10b981",
    "warning": "#f59e0b",
    "error": "#ef4444",
    "background": "#ffffff",
    "text": "#1f2937"
  },
  "typography": {
    "font_family_base": "Inter, system-ui, sans-serif",
    "font_family_heading": "Poppins, sans-serif",
    "font_size_base": "16px",
    "font_size_lg": "18px",
    "font_size_xl": "20px",
    "line_height_base": "1.5"
  },
  "sections": {
    "hero": {
      "name": "Hero Section",
      "description": "Full-width hero banner with CTA",
      "customizable": ["title", "subtitle", "button_text", "background_image"]
    },
    "featured-products": {
      "name": "Featured Products",
      "description": "Grid of featured products",
      "customizable": ["title", "limit", "columns"]
    },
    "categories": {
      "name": "Category Showcase",
      "description": "Display product categories",
      "customizable": ["title", "layout"]
    },
    "flash-sale": {
      "name": "Flash Sale Banner",
      "description": "Promotional flash sale section",
      "customizable": ["title", "countdown", "products"]
    },
    "newsletter": {
      "name": "Newsletter Signup",
      "description": "Email subscription form",
      "customizable": ["title", "description", "button_text"]
    }
  },
  "layouts": {
    "homepage": [
      {"component": "hero", "enabled": true, "order": 1},
      {"component": "featured-products", "enabled": true, "order": 2},
      {"component": "categories", "enabled": true, "order": 3},
      {"component": "flash-sale", "enabled": true, "order": 4},
      {"component": "newsletter", "enabled": false, "order": 5}
    ]
  }
}
