		@push('scripts')
			<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
			<script>
				function attributeManager() {
					return {
						showModal: false,
						showToast: false,
						toastMessage: '',
						formData: {
							id: null,
							name: '',
							type: 'text',
							description: '',
							is_required: false,
							is_filterable: false
						},

						init() {
							@if (session('success'))
								this.toast('{{ session('success') }}');
							@endif

							// Listen for add-value events
							this.$el.addEventListener('add-value', (e) => {
								this.addValuePrompt(e.detail);
							});
						},

						openCreateModal() {
							this.resetForm();
							this.showModal = true;
						},

						editAttribute(id, name, type, is_required, is_filterable, description) {
							this.formData = {
								id: id,
								name: name,
								type: type,
								description: description,
								is_required: is_required,
								is_filterable: is_filterable
							};
							this.showModal = true;
						},

						closeModal() {
							this.showModal = false;
							this.resetForm();
						},

						resetForm() {
							this.formData = {
								id: null,
								name: '',
								type: 'text',
								description: '',
								is_required: false,
								is_filterable: false
							};
						},

						async saveAttribute() {
							const url = this.formData.id ?
								`/admin/attributes/${this.formData.id}` :
								'/admin/attributes';
							const method = this.formData.id ? 'PUT' : 'POST';

							try {
								const response = await fetch(url, {
									method: method,
									headers: {
										'Content-Type': 'application/json',
										'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
									},
									body: JSON.stringify(this.formData)
								});

								const data = await response.json();
								if (data.success) {
									this.toast(data.message || 'Attribute saved successfully');
									setTimeout(() => window.location.reload(), 1500);
								}
							} catch (error) {
								console.error('Error:', error);
								this.toast('Error saving attribute');
							}
						},

						async deleteAttribute(id) {
							if (!confirm('Are you sure you want to delete this attribute?')) return;

							try {
								const response = await fetch(`/admin/attributes/${id}`, {
									method: 'DELETE',
									headers: {
										'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
									}
								});

								const data = await response.json();
								if (data.success) {
									this.toast(data.message || 'Attribute deleted successfully');
									setTimeout(() => window.location.reload(), 1500);
								}
							} catch (error) {
								console.error('Error:', error);
								this.toast('Error deleting attribute');
							}
						},

						addValuePrompt(attributeId) {
							const value = prompt('Enter new value:');
							if (!value) return;

							fetch(`/admin/attributes/${attributeId}/values`, {
									method: 'POST',
									headers: {
										'Content-Type': 'application/json',
										'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
									},
									body: JSON.stringify({
										value: value
									})
								})
								.then(res => res.json())
								.then(data => {
									if (data.success) {
										this.toast('Value added successfully');
										setTimeout(() => window.location.reload(), 1500);
									}
								});
						},

						toast(message) {
							this.toastMessage = message;
							this.showToast = true;
							setTimeout(() => this.showToast = false, 3000);
						}
					};
				}

				function valueManager(attributeId, initialValues) {
					return {
						attributeId: attributeId,
						values: initialValues.map(v => ({
							...v,
							editing: false
						})),
						sortable: null,

						init() {
							this.$nextTick(() => {
								const container = this.$refs.valueContainer;
								if (container && typeof Sortable !== 'undefined') {
									this.sortable = Sortable.create(container, {
										animation: 150,
										ghostClass: 'opacity-50',
										onEnd: () => this.saveOrder()
									});
								}
							});
						},

						startEdit(index) {
							// Close all other editors first
							this.values.forEach((v, i) => {
								if (i !== index) v.editing = false;
							});
							this.values[index].editing = true;
							this.$nextTick(() => {
								const input = this.$el.querySelectorAll('input[x-model="value.value"]')[index];
								if (input) {
									input.focus();
									input.select();
								}
							});
						},

						cancelEdit(index) {
							this.values[index].editing = false;
						},

						async saveValue(index) {
							const value = this.values[index];
							value.editing = false;

							try {
								await fetch(`/admin/attributes/${this.attributeId}/values/${value.id}`, {
									method: 'PUT',
									headers: {
										'Content-Type': 'application/json',
										'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
									},
									body: JSON.stringify({
										value: value.value
									})
								});
							} catch (error) {
								console.error('Error:', error);
							}
						},

						async deleteValue(index) {
							if (!confirm('Delete this value?')) return;

							const value = this.values[index];
							try {
								const response = await fetch(`/admin/attributes/${this.attributeId}/values/${value.id}`, {
									method: 'DELETE',
									headers: {
										'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
									}
								});
								const data = await response.json();
								if (data.success) {
									this.values.splice(index, 1);
								}
							} catch (error) {
								console.error('Error:', error);
							}
						},

						async addValue() {
							const newValue = prompt('Enter new value:');
							if (!newValue) return;

							try {
								const response = await fetch(`/admin/attributes/${this.attributeId}/values`, {
									method: 'POST',
									headers: {
										'Content-Type': 'application/json',
										'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
									},
									body: JSON.stringify({
										value: newValue
									})
								});
								const data = await response.json();
								if (data.success) {
									window.location.reload();
								}
							} catch (error) {
								console.error('Error:', error);
							}
						},

						async saveOrder() {
							const order = Array.from(this.$refs.valueContainer.querySelectorAll('.value-chip')).map(el => el
								.dataset.valueId);

							try {
								await fetch(`/admin/attributes/${this.attributeId}/values/reorder`, {
									method: 'POST',
									headers: {
										'Content-Type': 'application/json',
										'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
									},
									body: JSON.stringify({
										order: order
									})
								});
							} catch (error) {
								console.error('Error:', error);
							}
						}
					};
				}
			</script>
		@endpush
	@endsection
